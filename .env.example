# Local-only defaults. Set APP_ENV=production and EMAIL_BACKEND=smtp in deployed environments.
APP_ENV=development
EMAIL_BACKEND=log
PUBLIC_API_BASE_URL=http://localhost:8000

# Local SQLite database. Use PostgreSQL for shared/staging/production deployments.
DATABASE_URL=sqlite:///./myeconomy.db

# SMTP settings (required when EMAIL_BACKEND=smtp)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=replace-me
# SMTP_PASSWORD=replace-me
# SMTP_STARTTLS=true
# EMAIL_FROM=no-reply@example.com

# Local/demo-only private evidence storage. Production must inject an encrypted object-store adapter.
AWNNORA_DOCUMENT_ROOT=./.data/private_documents

# Optional AwnNORA Meta model explanation (server-side only; Standard mode).
# Never expose this key to apps/web or browser JavaScript.
# MODEL_API_KEY=replace-with-meta-model-api-key
